# ============================================================
# OpsPilot 环境变量模板
# 使用方法：复制本文件为 .env 并填写真实值
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
# 注意：.env 已被 .gitignore 排除，禁止提交到版本库
# ============================================================

# 应用配置
APP_NAME=OpsPilot
DEBUG=True
HOST=0.0.0.0
PORT=9900

# DashScope 配置（必填）
# API Key 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置
RAG_TOP_K=3
RAG_MODEL=qwen-max

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置（transport: stdio | sse | streamable-http）
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# 混合检索（向量 + BM25 关键词，融合方式 rrf 推荐 / normalize 归一化）
HYBRID_ENABLED=true
ES_INDEX=opspilot_knowledge
HYBRID_FUSION=rrf
HYBRID_RRF_K=60
HYBRID_RECALL_K=10
HYBRID_ALPHA=0.5
# 本地模式下的 Elasticsearch 地址（Docker 模式由 compose 注入 http://elasticsearch:9200）
ES_URL=http://localhost:9200

# 会话记忆后端：memory（默认，重启丢失）| redis | postgres
MEMORY_BACKEND=memory
# Redis 需使用 Redis Stack（含 RediSearch）；compose 将宿主机 6380 映射到容器 6379
REDIS_URL=redis://localhost:6380/0
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/langgraph

# 自动响应（实时告警接入）
AUTO_RESPONSE_ENABLED=true
ALERT_POLL_INTERVAL=30
ALERT_COOLDOWN_SECONDS=900

# 闭环沉淀（诊断结果回写知识库）
KNOWLEDGE_DISTILL_ENABLED=true

# Prometheus（告警查询工具等）
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10.0

# ============================================================
# 通知（飞书机器人）
# 只有自动告警入口（source=alert_auto）的诊断结果会推送到飞书；
# 用户在 Chat 页面主动触发的诊断只返回前端展示，不推送。
# ============================================================
# 飞书群自定义机器人 Webhook（群设置 → 群机器人 → 添加机器人 → 复制 Webhook 地址）
FEISHU_WEBHOOK_URL=
# 若机器人开启了"签名校验"，填写密钥；否则留空
FEISHU_SECRET=
FEISHU_TIMEOUT=5.0
# 通知总开关（false 时任何来源都不推送）
NOTIFICATION_ENABLED=true
# 幂等窗口（秒）：同一会话 + 同一告警 + 同一状态在该窗口内只发一次
NOTIFICATION_IDEMPOTENCY_TTL=900

# ============================================================
# 告警去重（避免同一条持续告警反复诊断/反复通知）
#   once_per_incident（默认）：同一次告警只诊断+通知一次，直到告警恢复(resolved)后再次触发
#   cooldown            ：旧行为，冷却窗口过期后持续未恢复的告警会再次触发
# ============================================================
ALERT_DEDUP_MODE=once_per_incident
# 仅 cooldown 模式生效：冷却窗口秒数
ALERT_COOLDOWN_SECONDS=900
